<UserControl x:Class="MyMall.Views.Admin.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + кнопки -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Управление товарами"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="➕ Добавить"
        Command="{Binding AddProductCommand}"
        Padding="15,8"
        Margin="0,0,10,0"
        Background="#27AE60"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"/>

                <Button Content="✏️ Редактировать"
        Command="{Binding EditProductCommand}"
        Padding="15,8"
        Margin="0,0,10,0"
        Background="#3498DB"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"
        IsEnabled="{Binding IsProductSelected}"/>

                <Button Content="🗑️ Удалить"
        Command="{Binding DeleteProductCommand}"
        Padding="15,8"
        Background="#E74C3C"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"
        IsEnabled="{Binding IsProductSelected}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="🔍 Найти"
                    Command="{Binding SearchCommand}"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Background="#3498DB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Grid.Column="2"
                    Content="✖ Сброс"
                    Command="{Binding ClearSearchCommand}"
                    Padding="15,8"
                    Margin="10,0,0,0"
                    Background="#95A5A6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="White"
                  BorderBrush="#DDD"
                  BorderThickness="1"
                  RowHeight="40">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="Закупка" Binding="{Binding PurchasePrice, StringFormat={}{0:C}}" Width="100"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Штрихкод" Binding="{Binding Barcode}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>


        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="#E74C3C"
                   Margin="0,10,0,0"
                   MinHeight="20"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>