<Window x:Class="MyMall.Views.Admin.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Название -->
        <TextBlock Grid.Row="0" Text="Название *" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" 
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8" FontSize="14" Margin="0,0,0,15"/>

        <!-- Описание -->
        <TextBlock Grid.Row="2" Text="Описание" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="3" 
                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8" FontSize="14" 
                 Height="60"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,15"/>

        <!-- Штрихкод -->
        <TextBlock Grid.Row="4" Text="Штрихкод" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" 
                 Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8" FontSize="14" Margin="0,0,0,15"/>

        <!-- Цены -->
        <Grid Grid.Row="6" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Цена продажи *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Закупочная цена *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- Количество + Категория -->
        <Grid Grid.Row="7" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Количество *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" FontSize="14"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Категория *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name"
                          Padding="8" FontSize="14"/>
            </StackPanel>
        </Grid>

        <!-- Ошибка -->
        <TextBlock Grid.Row="8"
                   Text="{Binding ErrorMessage}"
                   Foreground="#E74C3C"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,0,0,15"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Background="#95A5A6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button Content="Сохранить"
                    Command="{Binding SaveCommand}"
                    Padding="20,10"
                    Background="#27AE60"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>