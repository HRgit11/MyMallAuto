<Window x:Class="MyMall.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyMall — Вход" 
        Height="562" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F5F5F5">
        <Border Background="White" 
                CornerRadius="10" 
                Padding="40"
                Margin="40"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="0"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="MyMall" 
                           FontSize="32" 
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50"/>

                <TextBlock Text="Вход в систему" 
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="#7F8C8D"
                           Margin="0,5,0,30"/>

                <TextBlock Text="Логин" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Padding="10"
                         FontSize="14"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox"
                             Padding="10"
                             FontSize="14"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,15"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E74C3C"
                           TextWrapping="Wrap"
                           Margin="0,0,0,15"
                           MinHeight="20"/>

                <Button Content="Войти"
                        Command="{Binding LoginCommand}"
                        Padding="10"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#3498DB"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Height="45">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>