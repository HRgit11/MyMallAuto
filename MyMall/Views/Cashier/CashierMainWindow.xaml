<Window x:Class="MyMall.Views.Cashier.CashierMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyMall.ViewModels.Cashier"
        xmlns:views="clr-namespace:MyMall.Views.Cashier"
        Title="MyMall — Касса"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel>
                <Border Padding="20" Background="#1A252F">
                    <StackPanel>
                        <TextBlock Text="MyMall" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Касса" FontSize="11" Foreground="#95A5A6" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Padding="20,15" Background="#34495E">
                    <StackPanel>
                        <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Кассир" FontSize="11" Foreground="#95A5A6" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,20,0,0">
                    <Button Content="🛒 Новая продажа"
                            Command="{Binding ShowSaleCommand}"
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Content="📋 История продаж"
                            Command="{Binding ShowSalesHistoryCommand}"
                            Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>

                <Button Content="🚪 Выйти"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource MenuButtonStyle}"
                        Margin="0,20,0,0"
                        Foreground="#E74C3C"/>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="20,0">
                <TextBlock Text="Рабочее место кассира"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="#7F8C8D"/>
            </Border>

            <ContentControl Grid.Row="1"
                Content="{Binding CurrentViewModel}"
                Margin="20">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:SaleViewModel}">
                        <views:SaleView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
                        <views:SalesHistoryView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>